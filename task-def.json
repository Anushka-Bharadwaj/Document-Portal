{
  "family": "document-portal-task",
  "executionRoleArn": "arn:aws:iam::891377089986:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "document-portal",
      "image": "891377089986.dkr.ecr.ap-southeast-2.amazonaws.com/document-portal:latest",
      "memory": 512,
      "cpu": 256,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80
        }
      ]
    }
  ],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
}
